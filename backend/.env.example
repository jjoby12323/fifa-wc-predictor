# Copy this file to .env and fill in values

# A long random string — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_string

# Separate key for /admin/* endpoints — share only with yourself
ADMIN_KEY=change_me_to_another_random_string

# Public base URL of the app (no trailing slash)
# Local: http://localhost:8000
# Production: https://yourdomain.com
BASE_URL=http://localhost:8000

# SQLite (local/Fly.io) or PostgreSQL (Neon/Render)
# Local:      sqlite+aiosqlite:///./fifa.db
# Fly.io:     sqlite+aiosqlite:////data/fifa.db
# PostgreSQL: postgresql+asyncpg://user:pass@host/dbname
DATABASE_URL=sqlite+aiosqlite:///./fifa.db

# Register free at https://www.football-data.org/client/register
FOOTBALLDATA_API_KEY=your_api_key_here

# Comma-separated origins allowed to call the API
# Local dev: *
# Production: https://yourdomain.com
ALLOWED_ORIGINS=*
